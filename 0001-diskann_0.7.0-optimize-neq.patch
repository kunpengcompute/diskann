+        diskann::cout << ", io_limit: " << search_io_limit << "." << std::endl;
+
+    std::string warmup_query_file = index_path_prefix + "_sample_data.bin";
+
+    // load query bin
+    T *query = nullptr;
+    uint32_t *gt_ids = nullptr;
