+template <typename T, typename LabelT> void PQFlashIndexMGV2<T, LabelT>::set_reorder_ratio(const float reorder_ratio)
+{
+#ifdef FAST_DISKANN
+    _reorder_ratio = std::clamp(reorder_ratio, 0.0f, 1.0f);
+#else
+    _reorder_ratio = reorder_ratio;
+#endif
+}
